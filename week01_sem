      "source": [
        "def text_to_bow(text):\n",
        "    \"\"\" convert text string to an array of token counts. Use bow_vocabulary. \"\"\"\n",
        "    bow_index = {token: i for i, token in enumerate(bow_vocabulary)}\n",
        "    result = np.zeros(len(bow_vocabulary), dtype='float32')\n",
        "\n",
        "    for token in text.split():\n",
        "        idx = bow_index.get(token)\n",
        "        if idx is not None:\n",
        "            result[idx] += 1\n",
        "\n",
        "    return result"
      ]
    },
